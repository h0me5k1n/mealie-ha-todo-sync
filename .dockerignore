# The Dockerfile does `COPY . .`, so anything not listed here ends up in the
# image. Local builds (docker compose) otherwise bake in secrets from .env and
# the developer's .venv, whose stale packages also show up in image scans.

# Secrets — .env.example is a template with no real values, so it may stay
.env
.env.*
!.env.example

# Local environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# Repo and dev-only files the runtime doesn't need
.git/
.github/
.claude/
tests/
